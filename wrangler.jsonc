{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moviloq",
  "account_id": "ab8ac7142cabc51b891e1a119a2a2710",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "ENVIRONMENT": "development" },
  "env": {
    "production": {
      "name": "moviloq",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production" },
      "routes": [
        { "pattern": "moviloq.com", "custom_domain": true },
        { "pattern": "www.moviloq.com", "custom_domain": true }
      ]
    },
    "preview": {
      "name": "moviloq-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": { "ENVIRONMENT": "preview" }
    }
  }
  // The D1 binding is added after the Cloudflare database is created:
  // "d1_databases": [{
  //   "binding": "DB",
  //   "database_name": "moviloq",
  //   "database_id": "<created-database-id>",
  //   "migrations_dir": "migrations"
  // }]
}
