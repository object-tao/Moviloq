{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moviloq",
  "account_id": "ab8ac7142cabc51b891e1a119a2a2710",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [{ "binding": "DB", "database_name": "moviloq", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "DRAFT_LIMITER", "namespace_id": "260913001", "simple": { "limit": 60, "period": 60 } }],
  "env": {
    "production": {
      "name": "moviloq",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [{ "binding": "DB", "database_name": "moviloq-production", "database_id": "3b9a22d0-659a-4e26-bb8a-17c35f96750a", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "DRAFT_LIMITER", "namespace_id": "260913002", "simple": { "limit": 60, "period": 60 } }],
      "triggers": { "crons": ["15 3 * * *"] },
      "routes": [
        { "pattern": "moviloq.com", "custom_domain": true },
        { "pattern": "www.moviloq.com", "custom_domain": true }
      ]
    },
    "preview": {
      "name": "moviloq-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": { "ENVIRONMENT": "preview" },
      "d1_databases": [{ "binding": "DB", "database_name": "moviloq-preview-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "DRAFT_LIMITER", "namespace_id": "260913003", "simple": { "limit": 60, "period": 60 } }]
    }
  }
}
