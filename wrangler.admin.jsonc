{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moviloq-admin",
  "account_id": "ab8ac7142cabc51b891e1a119a2a2710",
  "main": "./worker/admin.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "development", "ADMIN_HOSTNAME": "admin.moviloq.com" },
  "routes": [],
  "env": {
    "production": {
      "name": "moviloq-admin",
      "routes": [{ "pattern": "admin.moviloq.com", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "production", "ADMIN_HOSTNAME": "admin.moviloq.com" }
    },
    "local": {
      "name": "moviloq-admin-local",
      "routes": [],
      "vars": { "ENVIRONMENT": "development", "ADMIN_HOSTNAME": "admin.moviloq.com" }
    }
  }
}
