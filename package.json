{
  "name": "moviloq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "admin:build": "wrangler deploy --dry-run --config wrangler.admin.jsonc --env production --outdir dist/admin",
    "admin:dev": "wrangler dev --config wrangler.admin.jsonc --env local --port 8788",
    "preview": "pnpm build && vite preview",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm admin:build",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply moviloq --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production --config wrangler.jsonc"
  },
  "dependencies": {
    "hono": "4.13.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
